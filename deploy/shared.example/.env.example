# Square Distributor Manager: live server settings for mke.rockproviders.com
#
# This file lives in ~/mke/shared/.env, outside the web root and outside the
# app folder, so updates never overwrite it. Only change the lines marked
# "FILL IN". Keep a copy of this file somewhere safe (not on the server).

APP_NAME="Square Distributor Manager"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mke.rockproviders.com
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Leave empty. The Maintenance page button "Generate APP_KEY" fills it in.
# Never change it after the app holds data.
APP_KEY=

# FILL IN: from cPanel > MySQL Databases (full names include the cPanel prefix,
# for example rockprov_mke).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# FILL IN: a long secret phrase only you know (at least 20 characters).
# You type it to open https://mke.rockproviders.com/maintenance
MAINTENANCE_TOKEN=
MAINTENANCE_ENABLED=true
# Only if the owner forgot the password: set to true, reset it on the
# Maintenance page, then set it back to false (DEPLOY.md, "Owner forgot the password").
MAINTENANCE_OWNER_RECOVERY=false

SDM_FIRM_NAME="M/s Khaza Enterprise"
SDM_DISTRIBUTOR_CODE=4831

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
# OPTIONAL: "Forgot your password?" e-mails. Make a mailbox in cPanel > Email
# Accounts (for example noreply@rockproviders.com), then replace the line
# MAIL_MAILER=log above with these (cPanel > Email Accounts > Connect Devices
# shows the server name and port):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=mail.rockproviders.com
# MAIL_PORT=465
# MAIL_USERNAME=noreply@rockproviders.com
# MAIL_PASSWORD="the mailbox password"
# MAIL_FROM_ADDRESS=noreply@rockproviders.com
# MAIL_FROM_NAME="${APP_NAME}"

# OPTIONAL: Google OAuth for export to Sheets / Drive (Settings → Google integration).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/google/callback"
